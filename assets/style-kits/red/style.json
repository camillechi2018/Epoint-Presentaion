  "visual_rules": {
    "name": "红白简约",
    "background": "白底、深红主强调与少量浅红信息面；新绘正文底层使用两枚锁定主题色的低透明度柔边椭圆",
    "title": "正文页左上角 24 pt 主题红标题，右上角使用黑色单色 Logo，标题下方使用同知识库正文页的红色细分隔线",
    "structure": "沿用蓝红简约系列的平面流程、并列、对比和图表结构，图形主色取红色主题变量",
    "visual_rhythm": "重点结论使用深红，正文保持白底留白，避免红色模块连续满屏",
    "image": "只使用红色系标签及已验证的来源图片，不把暖金或蓝色素材当作红色背景；来源样本图仅展示版式，若含旧彩色 Logo，实际出稿仍按黑白灰规则替换"
  },
  "layout_principles": {
    "canvas": "16:9；正文标题、分隔线和 Logo 固定读取 offline-core.json.content_header，仅横线下方的内容按信息关系弹性排布",
    "logo": "浅底黑色、深底白色；源页已有灰色单色 Logo 可保留。红色风格禁用蓝红彩色 Logo；避开标题和图形",
    "shadows": "none",
    "background_effect": "新绘正文统一读取 offline-core.json.content_atmosphere；可编辑椭圆、主题锁色、预设透明度、220 pt 柔边，知识库来源页不叠加",
    "editable": "正文文本与图形保持可编辑；预览图只作参考，不得整张贴为成稿",
    "counts": "依据真实信息量调整分栏和间距，不通过清空旧图形模拟减项",
    "text": "正文优先短句，字体低于 16pt 时重排或拆页"
  },
  "composition_recipes": {
    "parallel": "按真实条目数分栏；项数过多时换两行或拆页，标题和正文保持对齐",
    "process": "步骤与连接线同步增减；每步只保留阶段、动作和结果的必要信息",
    "comparison": "同维度左右对齐；不对称材料改用上下叙事，不强塞双列",
    "timeline": "日期顺序严格递增，节点与对应文字一起移动",
    "data": "图表注明单位、周期和来源；系列与摘要数值一致"
  },
  "prohibitions": [
